-- =====================================================
-- APPEARANCE COPIER LOGIC
-- =====================================================

local function isValidPart(obj)
	return obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Part")
end

-- NEW: Function to update dependencies info
local function updateDependenciesInfo()
	if not referencePart then
		dependenciesInfoLabel.Text = ""
		return
	end

	local dependencies = {}
	for _, child in ipairs(referencePart:GetChildren()) do
		if child:IsA("SurfaceAppearance") or child:IsA("Texture") or child:IsA("Decal") or 
			child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
			table.insert(dependencies, child.ClassName)
		end
	end

	if #dependencies > 0 then
		dependenciesInfoLabel.Text = "Found: " .. table.concat(dependencies, ", ")
		dependenciesInfoLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	else
		dependenciesInfoLabel.Text = "No dependencies found"
		dependenciesInfoLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end

local function setReferencePart()
	local selection = Selection:Get()

	if #selection == 0 then
		feedbackLabel.Text = "Warning: No part selected"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		return
	end

	for _, obj in ipairs(selection) do
		if isValidPart(obj) then
			referencePart = obj
			referenceLabel.Text = "Reference: " .. obj.Name
			referenceLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
			feedbackLabel.Text = "Reference set successfully!"
			feedbackLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

			-- Update property value displays
			updatePropertyDisplays()
			-- NEW: Update dependencies info
			updateDependenciesInfo()
			return
		end
	end

	feedbackLabel.Text = "Warning: No valid part selected"
	feedbackLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
end

-- NEW: Function to copy dependencies
local function copyDependencies(sourcePart, targetPart)
	-- Clear existing dependencies of the same type
	for _, child in ipairs(targetPart:GetChildren()) do
		if child:IsA("SurfaceAppearance") or child:IsA("Texture") or child:IsA("Decal") or
			child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
			child:Destroy()
		end
	end

	-- Copy all dependencies from source
	for _, child in ipairs(sourcePart:GetChildren()) do
		if child:IsA("SurfaceAppearance") or child:IsA("Texture") or child:IsA("Decal") or
			child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
			local clone = child:Clone()
			clone.Parent = targetPart
		end
	end
end

local function copyProperties()
	if not referencePart then
		feedbackLabel.Text = "Error: Set a reference part first"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	local selection = Selection:Get()
	if #selection == 0 then
		feedbackLabel.Text = "Error: Select target parts"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	-- Check if any property is selected (excluding custom name and dependencies)
	local hasSelectedProperty = false
	for _, checkbox in pairs(checkboxes) do
		if checkbox.enabled then
			hasSelectedProperty = true
			break
		end
	end

	-- Check if at least something will be modified
	local customName = nameTextBox.Text
	if not hasSelectedProperty and customName == "" and not copyDependenciesEnabled then
		feedbackLabel.Text = "Error: Select at least one property or action"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end

	ChangeHistoryService:SetWaypoint("Before copying properties")

	local copiedCount = 0
	local errorCount = 0

	for _, obj in ipairs(selection) do
		if isValidPart(obj) and obj ~= referencePart then
			local success = true

			-- NEW: Apply custom name if provided
			if customName ~= "" then
				local ok = pcall(function()
					obj.Name = customName
				end)
				if not ok then
					errorCount = errorCount + 1
					success = false
				end
			end

			-- Copy selected properties
			for propKey, checkbox in pairs(checkboxes) do
				if checkbox.enabled then
					local ok = pcall(function()
						if checkbox.special == "Position" then
							-- Handle PivotOffset Position
							local currentPivot = referencePart.PivotOffset
							local currentRotation = obj.PivotOffset
							obj.PivotOffset = CFrame.new(currentPivot.Position) * CFrame.Angles(currentRotation:ToEulerAnglesXYZ())
						elseif checkbox.special == "Orientation" then
							-- Handle PivotOffset Orientation
							local currentPivot = referencePart.PivotOffset
							local currentPosition = obj.PivotOffset.Position
							obj.PivotOffset = CFrame.new(currentPosition) * (currentPivot - currentPivot.Position)
						elseif checkbox.propertyName == "Color" then
							-- Handle Color with exact RGB values, avoiding BrickColor conversion
							local referenceColor = referencePart.Color
							obj.BrickColor = BrickColor.new("Medium stone grey") -- Set to neutral color first
							obj.Color = Color3.new(referenceColor.R, referenceColor.G, referenceColor.B) -- Force exact RGB
						else
							-- Handle normal properties (including Massless)
							obj[checkbox.propertyName] = referencePart[checkbox.propertyName]
						end
					end)

					if not ok then
						success = false
						errorCount = errorCount + 1
					end
				end
			end

			-- NEW: Copy dependencies if enabled
			if copyDependenciesEnabled then
				local ok = pcall(function()
					copyDependencies(referencePart, obj)
				end)
				if not ok then
					success = false
					errorCount = errorCount + 1
				end
			end

			if success then
				copiedCount = copiedCount + 1
			end
		end
	end

	ChangeHistoryService:SetWaypoint("After copying properties")

	if copiedCount > 0 then
		feedbackLabel.Text = string.format("Success: Properties copied to %d part(s)", copiedCount)
		feedbackLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	else
		feedbackLabel.Text = "Error: No parts were modified"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	end

	if errorCount > 0 then
		feedbackLabel.Text = feedbackLabel.Text .. string.format(" (Warning: %d error(s))", errorCount)
	end
end

local function clearReference()
	referencePart = nil
	referenceLabel.Text = "Reference: None selected"
	referenceLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
	feedbackLabel.Text = "Reference cleared"
	feedbackLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	dependenciesInfoLabel.Text = "" -- NEW: Clear dependencies info

	-- Clear property value displays
	updatePropertyDisplays()

	-- NEW: Clear name field
	nameTextBox.Text = ""
end

-- =====================================================
-- EVENT CONNECTIONS
-- =====================================================

setReferenceBtn.MouseButton1Click:Connect(setReferencePart)
applyBtn.MouseButton1Click:Connect(copyProperties)
clearBtn.MouseButton1Click:Connect(clearReference)

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

game.DescendantRemoving:Connect(function(descendant)
	if descendant == referencePart then
		clearReference()
		feedbackLabel.Text = "Warning: Reference part was deleted"
		feedbackLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
	end
end)

-- =====================================================
-- INITIALIZATION
-- =====================================================

print("====================================")
print("JapaTools loaded successfully!")
print("Version: 0.1.0")
print("====================================")
print("Available features:")
print("• Name Editor - Apply custom names to multiple parts")
print("• Appearance Copier - Copy visual properties between parts")
print("• Transform Copier - Copy size, position and orientation")
print("• Collision/Part Copier - Copy physics properties (including Massless)")
print("• Dependencies Copier - Copy SurfaceAppearance, Textures and more")
print("• More tools coming soon...")
print("====================================")]]></ProtectedString>
