-- Checkbox system
local checkboxes = {}

-- Create checkbox function
local function createCheckbox(name, displayName, parent, special)
	local checkboxFrame = Instance.new("Frame")
	checkboxFrame.Size = UDim2.new(1, 0, 0, 25)
	checkboxFrame.BackgroundTransparency = 1
	checkboxFrame.Parent = parent

	local checkbox = Instance.new("TextButton")
	checkbox.Size = UDim2.new(0, 20, 0, 20)
	checkbox.Position = UDim2.new(0, 5, 0, 2)
	checkbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	checkbox.Text = ""
	checkbox.Parent = checkboxFrame

	local checkmark = Instance.new("TextLabel")
	checkmark.Size = UDim2.new(1, 0, 1, 0)
	checkmark.BackgroundTransparency = 1
	checkmark.Text = "X"
	checkmark.TextColor3 = Color3.fromRGB(100, 255, 100)
	checkmark.Font = Enum.Font.SourceSansBold
	checkmark.TextSize = 16
	checkmark.Visible = false
	checkmark.Parent = checkbox

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 120, 1, 0) -- Fixed width for label
	label.Position = UDim2.new(0, 30, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = displayName
	label.TextColor3 = Color3.fromRGB(226, 226, 226)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14
	label.Parent = checkboxFrame

	-- Value display label (shows reference property values)
	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.new(1, -155, 1, 0) -- Takes remaining space
	valueLabel.Position = UDim2.new(0, 155, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = ""
	valueLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Left
	valueLabel.Font = Enum.Font.SourceSansItalic
	valueLabel.TextSize = 12
	valueLabel.Parent = checkboxFrame

	-- Create unique key for special properties
	local checkboxKey = name
	if special then
		checkboxKey = name .. "_" .. special
	end

	checkboxes[checkboxKey] = {
		button = checkbox,
		checkmark = checkmark,
		enabled = false,
		propertyName = name,
		special = special,
		valueLabel = valueLabel, -- Store reference to value label
		displayName = displayName -- Store display name for reference
	}

	checkbox.MouseButton1Click:Connect(function()
		checkboxes[checkboxKey].enabled = not checkboxes[checkboxKey].enabled
		checkmark.Visible = checkboxes[checkboxKey].enabled
	end)
end

-- Function to update property value displays
local function updatePropertyDisplays()
	if not referencePart then
		-- Clear all value displays if no reference
		for _, checkbox in pairs(checkboxes) do
			if checkbox.valueLabel then
				checkbox.valueLabel.Text = ""
			end
		end
		return
	end

	-- Update all property displays
	for checkboxKey, checkbox in pairs(checkboxes) do
		if checkbox.valueLabel then
			local success, value = pcall(function()
				if checkbox.special == "Position" then
					-- Handle PivotOffset Position
					local pivot = referencePart.PivotOffset
					return pivot.Position
				elseif checkbox.special == "Orientation" then
					-- Handle PivotOffset Orientation
					local pivot = referencePart.PivotOffset
					local x, y, z = pivot:ToEulerAnglesXYZ()
					return Vector3.new(math.deg(x), math.deg(y), math.deg(z))
				else
					-- Handle normal properties
					return referencePart[checkbox.propertyName]
				end
			end)

			if success and value ~= nil then
				local displayText = ""
				local propName = checkbox.propertyName

				-- Appearance Properties
				if propName == "Color" then
					-- Format Color as RGB values
					local r = math.floor(value.R * 255 + 0.5)
					local g = math.floor(value.G * 255 + 0.5)
					local b = math.floor(value.B * 255 + 0.5)
					displayText = string.format("%d, %d, %d", r, g, b)
				elseif propName == "DoubleSided" or propName == "CanCollide" or propName == "Anchored" or propName == "Massless" then
					-- Show boolean as checkmark or X
					displayText = value and "✓" or "X"
				elseif propName == "Material" then
					-- Show material name
					displayText = tostring(value):gsub("Enum%.Material%.", "")
				elseif propName == "MaterialVariant" then
					-- Show material variant (empty if none)
					displayText = value ~= "" and tostring(value) or "None"
				elseif propName == "RenderFidelity" then
					-- Show render fidelity
					displayText = tostring(value):gsub("Enum%.RenderFidelity%.", "")
				elseif propName == "Reflectance" or propName == "Transparency" then
					-- Show decimal values
					displayText = string.format("%.2f", value)

					-- Transform Properties
				elseif propName == "Size" then
					-- Format Size as X, Y, Z
					displayText = string.format("%.2f, %.2f, %.2f", value.X, value.Y, value.Z)
				elseif propName == "Position" then
					-- Format Position as X, Y, Z
					displayText = string.format("%.2f, %.2f, %.2f", value.X, value.Y, value.Z)
				elseif propName == "Orientation" then
					-- Format Orientation as X, Y, Z (in degrees)
					local x, y, z = referencePart.CFrame:ToEulerAnglesXYZ()
					displayText = string.format("%.1f°, %.1f°, %.1f°", math.deg(x), math.deg(y), math.deg(z))
				elseif propName == "PivotOffset" then
					if checkbox.special == "Position" then
						-- Format Origin Position as X, Y, Z
						displayText = string.format("%.2f, %.2f, %.2f", value.X, value.Y, value.Z)
					elseif checkbox.special == "Orientation" then
						-- Format Origin Orientation as X, Y, Z (in degrees)
						displayText = string.format("%.1f°, %.1f°, %.1f°", value.X, value.Y, value.Z)
					end
				else
					displayText = tostring(value)
				end

				checkbox.valueLabel.Text = displayText
			else
				checkbox.valueLabel.Text = "N/A"
			end
		end
	end
end

local function createSeparatorWithLabel(text, parent)
