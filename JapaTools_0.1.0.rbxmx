			<ProtectedString name="Source"><![CDATA[-- JapaTools for Roblox Studio
-- Version 0.1.0
-- Multi-function plugin with collapsible sections

-- =====================================================
-- INITIAL SETUP
-- =====================================================

local toolbar = plugin:CreateToolbar("JapaTools")
local button = toolbar:CreateButton(
	"JapaTools",
	"Multi-function development plugin",
	"rbxassetid://112717668264965"
	-- "rbxasset://textures/ui/Settings/Help/AvatarCompatibilityIcon@2x.png"
)

-- Required services
local Selection = game:GetService("Selection")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local TweenService = game:GetService("TweenService")

-- =====================================================
-- USER INTERFACE SETUP
-- =====================================================

-- Create widget (plugin window)
local widgetInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float,
	false,  -- Widget starts closed
	false,  -- Override previous saved state
	380,    -- Increased initial width
	600,    -- Increased initial height further
	320,    -- Increased minimum width
	550     -- Increased minimum height further
)

local widget = plugin:CreateDockWidgetPluginGui("JapaTools", widgetInfo)
widget.Title = "JapaTools"
widget.Name = "JapaTools"

-- Main frame
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(1, 0, 1, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(46, 46, 46)
mainFrame.BorderSizePixel = 0
mainFrame.Parent = widget

-- ScrollingFrame to contain all elements
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(1, -10, 1, -10)
scrollFrame.Position = UDim2.new(0, 5, 0, 5)
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 1200) -- Increased canvas size for new features
scrollFrame.ScrollBarThickness = 6
scrollFrame.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
scrollFrame.BorderSizePixel = 0
scrollFrame.Parent = mainFrame

-- Automatic layout
local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.Parent = scrollFrame

-- =====================================================
-- HELPER FUNCTIONS
-- =====================================================

-- Function to create labels
local function createLabel(text, parent, color)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 0, 25)
	label.Position = UDim2.new(0, 5, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(226, 226, 226)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.SourceSans
	label.TextSize = 16
	label.Parent = parent
	return label
end

-- Function to create separators
local function createSeparator(parent)
	local separator = Instance.new("Frame")
	separator.Size = UDim2.new(1, -10, 0, 1)
	separator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	separator.BorderSizePixel = 0
	separator.Parent = parent
	return separator
end

-- Function to create collapsible sections
local function createCollapsibleSection(title, parent)
	local sectionFrame = Instance.new("Frame")
	sectionFrame.Size = UDim2.new(1, 0, 0, 30)
	sectionFrame.BackgroundTransparency = 1
	sectionFrame.Parent = parent

	-- Header button (click to expand/collapse)
	local headerButton = Instance.new("TextButton")
	headerButton.Size = UDim2.new(1, -10, 0, 30)
	headerButton.Position = UDim2.new(0, 5, 0, 0)
	headerButton.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
	headerButton.Text = ""
	headerButton.Parent = sectionFrame

	-- Arrow indicator (starts expanded)
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 20, 1, 0)
	arrow.Position = UDim2.new(0, 5, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = "v"  -- Changed to expanded arrow
	arrow.TextColor3 = Color3.fromRGB(200, 200, 200)
	arrow.Font = Enum.Font.SourceSans
	arrow.TextSize = 14
	arrow.Parent = headerButton

	-- Section title
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -30, 1, 0)
	titleLabel.Position = UDim2.new(0, 25, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Font = Enum.Font.SourceSansBold
	titleLabel.TextSize = 16
	titleLabel.Parent = headerButton

	-- Content frame (starts expanded)
	local contentFrame = Instance.new("Frame")
	contentFrame.Size = UDim2.new(1, -10, 0, 0)  -- Will be adjusted when setHeight is called
	contentFrame.Position = UDim2.new(0, 5, 0, 35)
	contentFrame.BackgroundColor3 = Color3.fromRGB(42, 42, 42)
	contentFrame.BorderSizePixel = 0
	contentFrame.ClipsDescendants = true
	contentFrame.Parent = sectionFrame

	-- Content list layout
	local contentLayout = Instance.new("UIListLayout")
	contentLayout.Padding = UDim.new(0, 5)
	contentLayout.Parent = contentFrame

	-- Padding for content
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 5)
	padding.PaddingBottom = UDim.new(0, 5)
	padding.PaddingLeft = UDim.new(0, 5)
	padding.PaddingRight = UDim.new(0, 5)
	padding.Parent = contentFrame

	local isExpanded = true  -- Changed to true (starts expanded)
	local contentHeight = 0

	-- Toggle function
	local function toggleSection()
		isExpanded = not isExpanded

		if isExpanded then
			arrow.Text = "v"
			contentFrame.Size = UDim2.new(1, -10, 0, contentHeight)
			sectionFrame.Size = UDim2.new(1, 0, 0, 35 + contentHeight)

			-- Update scrolling canvas size to accommodate expanded content
			local newCanvasHeight = math.max(1200, 35 + contentHeight + 250)
			scrollFrame.CanvasSize = UDim2.new(0, 0, 0, newCanvasHeight)
		else
			arrow.Text = ">"
			contentFrame.Size = UDim2.new(1, -10, 0, 0)
			sectionFrame.Size = UDim2.new(1, 0, 0, 30)
		end
	end

	headerButton.MouseButton1Click:Connect(toggleSection)

	-- Return section data
	return {
		frame = sectionFrame,
		content = contentFrame,
		setHeight = function(height)
			contentHeight = height
			if isExpanded then
				contentFrame.Size = UDim2.new(1, -10, 0, contentHeight)
				sectionFrame.Size = UDim2.new(1, 0, 0, 35 + contentHeight)

				-- Update scrolling canvas size
				local newCanvasHeight = math.max(1200, 35 + contentHeight + 250)
				scrollFrame.CanvasSize = UDim2.new(0, 0, 0, newCanvasHeight)
			end
		end,
		expand = function()
			if not isExpanded then
				toggleSection()
			end
		end,
		collapse = function()
			if isExpanded then
				toggleSection()
			end
		end
	}
end

